# =============================================================================
# RESEARCHBRIDGE BACKEND ENVIRONMENT CONFIGURATION
# Copy this file to .env and replace placeholders with your actual secrets.
# =============================================================================

# Application Settings
ENVIRONMENT=development
PORT=8000
DEBUG=false
FRONTEND_ORIGIN=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000

# Supabase Credentials (from Project Settings -> API)
# Project URL (e.g., https://yourprojectref.supabase.co)
SUPABASE_URL=https://yourprojectref.supabase.co

# Supabase Anon Public Key (Publishable)
SUPABASE_ANON_KEY=your_supabase_anon_publishable_key

# Supabase Service Role Secret Key (Keep private! Server-side only)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# Supabase JWT Secret (from Project Settings -> API -> JWT Settings)
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# Optional: Supabase JWT Issuer URL
SUPABASE_JWT_ISSUER=https://yourprojectref.supabase.co/auth/v1

# Google Gemini AI Credentials
# Get your key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
